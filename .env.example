# Copy to .env and fill in. Never commit .env.

# Grader (OpenRouter): required to grade
OPENROUTER_API_KEY=
VISION_MODEL=
REASONING_MODEL=

# Server
PORT=3000
# One extra address to listen on besides 127.0.0.1 (e.g. 0.0.0.0, or a Tailscale IP)
# HOST=
# Behind a reverse proxy (Caddy/nginx): use the client address from X-Forwarded-For for rate limiting
# TRUST_PROXY=1

# Billing (Stripe): leave all STRIPE_* unset to run without billing. If any is set, all are required, and the key must match
# STRIPE_MODE (sk_test_ for sandbox, sk_live_ for live) or the server won't start. Sandbox and live have separate keys, Price IDs
# and webhook secrets; enable only one webhook destination at a time for this server, and use a separate DB_PATH per mode.
# Webhook endpoint: <APP_BASE_URL>/api/stripe/webhook (events: customer.subscription.created|updated|deleted|trial_will_end,
# checkout.session.completed, invoice.paid, invoice.payment_failed).
# STRIPE_MODE=sandbox
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# Public https URL of the site, for Checkout and portal return links (default: the request's own origin)
# APP_BASE_URL=https://gradelake.com

# Accounts
# SQLite file (default data/gradelake.db)
# DB_PATH=data/gradelake.db
# Emails that become admins (can edit the message of the day) when they register
ADMIN_EMAILS=
# In production the session cookie is Secure (HTTPS only). Set to 1 only to try `bun run start` over plain http.
# INSECURE_COOKIES=1
